# Copy this file to .env and fill in your values

# Anthropic API key (get from https://console.anthropic.com)
# Optional — scoring/tailoring works without it (uses local scoring)
ANTHROPIC_API_KEY=

# Minimum salary filter in LPA (Lakhs Per Annum)
MIN_SALARY_LPA=8

# Match threshold (0-100) — jobs above this get tailored resumes
MATCH_THRESHOLD=70

# Pages to scrape per site (more pages = more jobs but slower)
PAGES_PER_SITE=3

# Path to your resume JSON (relative to project root)
# RESUME_PATH=resume.json

# PDF style: "classic" (fpdf2, lightweight) or "modern" (HTML+Playwright, beautiful)
# Modern requires: pip install playwright && playwright install chromium
PDF_STYLE=classic

# Max job detail pages to fetch per scraper (for full descriptions)
MAX_DETAIL_FETCHES=20
